# ============================================================
# .gitignore 通用模板
# 用法：按需删减，只保留你项目用到的部分
#
# 语法速查（注意：# 注释必须独占一行，不能写在规则后面）：
#   # 注释              注释行
#   /dir/              只匹配目录
#   /file              只匹配仓库根目录下的 file
#   *.log              匹配任意层级的 .log
#   !keep              取消忽略（例外）
#   **                 跨目录匹配任意层级
#   调试命令：git check-ignore -v <path>
# ============================================================


# ---------- 系统与编辑器 ----------
# macOS
.DS_Store
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Vim / 通用备份
*.swp
*.swo
*~

# JetBrains 系列（IDEA / WebStorm / PyCharm ...）
.idea/

# VS Code：忽略整个目录，但保留团队共享的配置
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json


# ---------- 依赖目录 ----------
# Node
node_modules/
jspm_packages/
bower_components/

# PHP
vendor/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/


# ---------- 构建产物 ----------
build/
dist/
out/
target/
*.o
*.so
*.dll
*.exe
*.class


# ---------- 日志与临时文件 ----------
